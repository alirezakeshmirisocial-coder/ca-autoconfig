# Copy this file to .github/workflows/ci.yml after the GitHub CLI token
# has been authorized with the workflow scope.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  windows-tests:
    runs-on: windows-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 8.0.x
      - name: Guard smoke tests
        shell: pwsh
        run: .\tests\Guard.Smoke.Tests.ps1
      - name: HUD compile and policy tests
        shell: pwsh
        run: .\tests\SystemOverlay.Smoke.Tests.ps1
      - name: Compiled desktop smoke test
        shell: pwsh
        run: .\tests\DesktopApp.Smoke.Tests.ps1
      - name: Desktop package verifier tests
        shell: pwsh
        run: .\tests\DesktopPackageVerifier.Tests.ps1
      - name: Clean-machine sandbox preparation tests
        shell: pwsh
        run: .\tests\CleanMachineSandbox.Tests.ps1
      - name: Privileged helper safety tests
        shell: pwsh
        run: .\tests\GpuLimits.Safety.Tests.ps1
      - name: Read-only GPU limit plan tests
        shell: pwsh
        run: .\tests\GpuLimitPlan.Tests.ps1
      - name: Power-curve calculation and privacy tests
        shell: pwsh
        run: .\benchmark\Run-Tests.ps1
      - name: Adaptive fan policy tests
        shell: pwsh
        run: .\fan-control\Run-Tests.ps1
