# Copy this file to .github/workflows/ci.yml after the GitHub CLI token
# has been authorized with the workflow scope.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  windows-tests:
    runs-on: windows-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 8.0.x
      - name: Full repository checks
        shell: pwsh
        run: .\Invoke-RepositoryChecks.ps1 -Suite Full
