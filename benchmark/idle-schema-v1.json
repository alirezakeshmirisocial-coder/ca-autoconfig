{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alirezakeshmirisocial-coder/ca-autoconfig/blob/main/benchmark/idle-schema-v1.json",
  "title": "CA AutoConfig anonymized idle-power run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "createdUtc", "source", "condition", "privacy", "profile", "protocol", "result", "gpus"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "createdUtc": { "type": "string", "format": "date-time" },
    "source": { "enum": ["live", "fixture"] },
    "condition": { "enum": ["baseline", "candidate"] },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsGpuUuid", "containsMachineName", "containsUserName", "containsPaths", "containsRawCommand"],
      "properties": {
        "containsGpuUuid": { "const": false },
        "containsMachineName": { "const": false },
        "containsUserName": { "const": false },
        "containsPaths": { "const": false },
        "containsRawCommand": { "const": false }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "clockPolicy", "graphicsClockMaximumMHz"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+/-]*$" },
        "clockPolicy": { "enum": ["vendor-auto", "persistent-graphics-lock", "unknown"] },
        "graphicsClockMaximumMHz": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "clockPolicy": { "const": "persistent-graphics-lock" } } },
          "then": { "properties": { "graphicsClockMaximumMHz": { "type": "number", "exclusiveMinimum": 0 } } }
        },
        {
          "if": { "properties": { "clockPolicy": { "const": "vendor-auto" } } },
          "then": { "properties": { "graphicsClockMaximumMHz": { "type": "null" } } }
        }
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settleSeconds", "sampleSeconds", "intervalMilliseconds", "repetition"],
      "properties": {
        "settleSeconds": { "type": "integer", "minimum": 0 },
        "sampleSeconds": { "type": "integer", "minimum": 1 },
        "intervalMilliseconds": { "type": "integer", "minimum": 250 },
        "repetition": { "type": "integer", "minimum": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": { "enum": ["passed", "failed", "incomplete"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "gpus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "model", "driver", "powerLimitWatts", "samples"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "model": { "type": "string", "minLength": 1 },
          "driver": { "type": "string", "minLength": 1 },
          "powerLimitWatts": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["elapsedMilliseconds", "powerDrawWatts", "temperatureC", "utilizationPercent", "graphicsClockMHz"],
              "properties": {
                "elapsedMilliseconds": { "type": "integer", "minimum": 0 },
                "powerDrawWatts": { "type": ["number", "null"], "minimum": 0 },
                "temperatureC": { "type": ["number", "null"] },
                "utilizationPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "graphicsClockMHz": { "type": ["number", "null"], "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
